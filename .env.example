EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Item #81 — chaves separadas por uso (cada uma restrita no Google Cloud ao
# seu próprio pacote/bundle + API). Nunca reutilizar a mesma chave nos dois.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=restrita-a-com.goxl.app-android
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=restrita-a-com.goxl.app-ios

# A chave de Places/Geocoding NÃO fica no app — é GOOGLE_PLACES_API_KEY,
# secret do Supabase (supabase secrets set), consumida só pela Edge Function
# `places-search`. Não existe variável EXPO_PUBLIC_* para ela.
